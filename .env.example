# Pooled or direct runtime connection used only by server code.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Direct, non-pooler connection used by migrations and administrative scripts.
DATABASE_URL_DIRECT=postgresql://user:password@host/database?sslmode=require

# Optional isolated PostgreSQL database used by integration tests.
TEST_DATABASE_URL=

# Generate with: npx auth secret
AUTH_SECRET=replace-with-at-least-32-random-characters

# Application URL used by Auth.js outside Vercel.
NEXTAUTH_URL=http://localhost:3000

# Administrative commands read credentials from the environment, not CLI arguments.
ADMIN_USERNAME=
ADMIN_PASSWORD=
