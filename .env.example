# ────────────────────────────────────────────────────────────────
# Vercel (Production) — set these in the Vercel project dashboard.
# ────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string used by the running application.
# Must start with "postgresql://" and have the password URL-encoded.
# Use sslmode=verify-full: pg treats require/prefer/verify-ca as aliases for
# verify-full and warns about it, and verify-full states the intent explicitly.
DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full

# Secret used to encrypt staff login cookies. Generate one value and
# reuse it for this environment: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=replace-with-at-least-32-random-characters

# Key used to encrypt/decrypt stored credential numbers (FFN, KEMSIS, FEMA SID).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THIS UP — losing it makes stored credentials unrecoverable.
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-base64-encoded-bytes

# Canonical public origin used by authentication and class sign-in QR codes.
NEXTAUTH_URL=https://your-app.vercel.app

# IANA time zone used to interpret and display class session times.
DEPARTMENT_TIME_ZONE=America/New_York

# Resend API key used only by server-side official-roster email delivery.
# Configure a verified noreply@winchesterfireems.com sender in Resend first.
RESEND_API_KEY=replace-with-a-server-only-resend-key

# ────────────────────────────────────────────────────────────────
# Local / CI only — never add these to Vercel.
# ────────────────────────────────────────────────────────────────

# Direct (non-pooler) connection used by migrations and admin commands.
DATABASE_URL_DIRECT=postgresql://user:password@host/database?sslmode=verify-full

# Optional isolated PostgreSQL database used by integration tests.
# Reset before each run with: npm run db:reset:integration
TEST_DATABASE_URL=

# Dedicated PostgreSQL database used by the end-to-end browser suite.
# Must be a different database than TEST_DATABASE_URL.
# Reset before each run with: npm run db:reset:e2e
E2E_DATABASE_URL=

# Existing finalized class fixture used only by the optional official-roster E2E test.
E2E_OFFICIAL_ROSTER_CLASS_ID=

# Staff credentials used by the browser suite. Bootstrap these accounts in the
# end-to-end database before running it (see docs/verification.md).
E2E_STAFF_USERNAME=
E2E_STAFF_PASSWORD=
E2E_INSTRUCTOR_USERNAME=
E2E_INSTRUCTOR_PASSWORD=

# Credentials used by the staff account commands (scripts/admin.ts).
# Passwords are read from the environment, never from command-line args.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
