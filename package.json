{
  "name": "roster-tracking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src scripts tests drizzle.config.ts next.config.ts playwright.config.ts postcss.config.mjs vitest.config.ts vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "import:training-codes": "tsx scripts/import-training-codes.ts",
    "admin": "tsx scripts/admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@node-rs/argon2": "2.2.0",
    "@vercel/functions": "3.9.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-auth": "4.24.15",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "24.3.0",
    "@types/pg": "8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "postcss": "8.5.26",
    "tailwindcss": "4.1.11",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "@tailwindcss/oxide@4.1.11": true
  }
}
