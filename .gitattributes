# Normalize line endings: store LF in the repository and check out LF on every
# platform. Without this, Git on Windows (core.autocrlf=true) rewrites text
# files to CRLF on checkout, which fails `npm run check` (Biome expects LF).
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.woff binary
*.woff2 binary
